# 复制为 .env.content；该文件已被 Git 忽略。CLI 自动读取，系统环境变量优先。
# 本地默认 Whisper；FunASR 可设为 funasr，自动选独立 .venv-funasr。
CONTENT_ASR_PROVIDER=whisper
# 留空按提供方选择：Whisper=base，FunASR=paraformer-zh。
CONTENT_ASR_MODEL=
CONTENT_LANGUAGE=zh
# CONTENT_PYTHON=/绝对路径/.venv-content/bin/python
# 留空表示本地算力费用尚未核算，不能把它当成零成本。
CONTENT_ASR_CNY_PER_MINUTE=
CONTENT_BUDGET_CNY=0.05
CONTENT_MAX_DURATION_SECONDS=900
CONTENT_MAX_FRAMES=6
CONTENT_FRAME_INTERVAL_SECONDS=15

# qwen 或 doubao，均使用 chat/completions 兼容协议。
CONTENT_VISION_PROVIDER=qwen
# 下面是 Qwen 北京地域；API Key 必须属于同一地域。
# 官方价格核对于 2026-10-19：https://help.aliyun.com/zh/model-studio/qwen-vl-plus
# 豆包默认：https://ark.cn-beijing.volces.com/api/v3
CONTENT_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CONTENT_VISION_MODEL=qwen-vl-plus
# 推荐运行 npm run content:configure-key 隐藏输入；也支持 DASHSCOPE_API_KEY。
CONTENT_VISION_API_KEY=
# 按供应商当前价格填写人民币/百万tokens；包含图像对应的输入tokens。
# 若所选模型的图片/推理tokens有其他收费方式，先调整适配器，不能填零掩盖。
CONTENT_VISION_INPUT_CNY_PER_MILLION=0.8
CONTENT_VISION_OUTPUT_CNY_PER_MILLION=2
# 为一次视觉请求预留费用，必须覆盖下面token上限按单价计算的估算额。
CONTENT_VISION_MAX_COST_CNY=0.02
CONTENT_VISION_MAX_INPUT_TOKENS=16000
CONTENT_VISION_MAX_OUTPUT_TOKENS=1500

# 自动出题（独立配置；模型及价格留空时暂停出题，已有内容与草稿保留）。
# 同提供方且端点完全相同时，可留空QUESTION_API_KEY复用视觉凭证。
# model填控制台实际可用的非推理文本模型；价格填该模型当前人民币单价。
CONTENT_QUESTION_PROVIDER=qwen
CONTENT_QUESTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CONTENT_QUESTION_MODEL=
CONTENT_QUESTION_API_KEY=
CONTENT_QUESTION_INPUT_CNY_PER_MILLION=
CONTENT_QUESTION_OUTPUT_CNY_PER_MILLION=
CONTENT_QUESTION_MAX_COST_CNY=
CONTENT_QUESTION_MAX_INPUT_TOKENS=12000
CONTENT_QUESTION_MAX_OUTPUT_TOKENS=2000
# 预留额必须覆盖(input上限*输入单价+output上限*输出单价)/1000000。
# CONTENT_BUDGET_CNY是同一内容的理解+出题累计预算。
# 每日批量条数/预算及开关由工作台或content:batch configure保存，不写在密钥文件。
