{
  "manifest_version": 3,
  "name": "收藏整理 Agent · 执行器",
  "version": "0.1.0",
  "description": "在抖音网页版执行未分类收藏的扫描与自动归类，由本地控制面服务调度。",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://*.douyin.com/*",
    "http://localhost:7788/*",
    "http://127.0.0.1:7788/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "收藏整理 Agent",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["content/inject-page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["content/driver.js"],
      "run_at": "document_idle"
    }
  ]
}
